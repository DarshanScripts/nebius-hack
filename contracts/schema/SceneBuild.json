{
  "$defs": {
    "AnimationCue": {
      "additionalProperties": false,
      "properties": {
        "cue_id": {
          "title": "Cue Id",
          "type": "string"
        },
        "word_ids": {
          "items": {
            "type": "string"
          },
          "title": "Word Ids",
          "type": "array"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "end_frame": {
          "exclusiveMinimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "cue_id",
        "start_frame",
        "end_frame",
        "description"
      ],
      "title": "AnimationCue",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "media_type",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "scene_id": {
      "title": "Scene Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "context_hash": {
      "title": "Context Hash",
      "type": "string"
    },
    "timeline_hash": {
      "title": "Timeline Hash",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "cues": {
      "items": {
        "$ref": "#/$defs/AnimationCue"
      },
      "title": "Cues",
      "type": "array"
    },
    "generation_mode": {
      "enum": [
        "agent",
        "fallback",
        "mock"
      ],
      "title": "Generation Mode",
      "type": "string"
    },
    "repair_attempts": {
      "default": 0,
      "maximum": 2,
      "minimum": 0,
      "title": "Repair Attempts",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "scene_id",
    "revision",
    "context_hash",
    "timeline_hash",
    "source",
    "summary",
    "generation_mode"
  ],
  "title": "SceneBuild",
  "type": "object"
}
