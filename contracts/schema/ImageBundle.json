{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "media_type",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ImageQuery": {
      "additionalProperties": false,
      "properties": {
        "scene_index": {
          "maximum": 6,
          "minimum": 1,
          "title": "Scene Index",
          "type": "integer"
        },
        "dialogue_ids": {
          "items": {
            "type": "string"
          },
          "title": "Dialogue Ids",
          "type": "array"
        },
        "query": {
          "title": "Query",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "scene_index",
        "dialogue_ids",
        "query",
        "reason"
      ],
      "title": "ImageQuery",
      "type": "object"
    },
    "ImageSelection": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "$ref": "#/$defs/ImageQuery"
        },
        "status": {
          "enum": [
            "selected",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "asset": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        },
        "source_page_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Page Url"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "query",
        "status"
      ],
      "title": "ImageSelection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "script_revision": {
      "title": "Script Revision",
      "type": "integer"
    },
    "selections": {
      "items": {
        "$ref": "#/$defs/ImageSelection"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Selections",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "script_revision",
    "selections"
  ],
  "title": "ImageBundle",
  "type": "object"
}
