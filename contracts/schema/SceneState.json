{
  "$defs": {
    "AnimationCue": {
      "additionalProperties": false,
      "properties": {
        "cue_id": {
          "title": "Cue Id",
          "type": "string"
        },
        "word_ids": {
          "items": {
            "type": "string"
          },
          "title": "Word Ids",
          "type": "array"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "end_frame": {
          "exclusiveMinimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "cue_id",
        "start_frame",
        "end_frame",
        "description"
      ],
      "title": "AnimationCue",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "media_type",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "PipelineError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "scene_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Id"
        }
      },
      "required": [
        "code",
        "stage",
        "message"
      ],
      "title": "PipelineError",
      "type": "object"
    },
    "RenderResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "completed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "progress": {
          "maximum": 1,
          "minimum": 0,
          "title": "Progress",
          "type": "number"
        },
        "video": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "poster": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "duration_frames": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Frames"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/PipelineError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "project_id",
        "job_id",
        "status",
        "progress"
      ],
      "title": "RenderResult",
      "type": "object"
    },
    "SceneBuild": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "context_hash": {
          "title": "Context Hash",
          "type": "string"
        },
        "timeline_hash": {
          "title": "Timeline Hash",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "cues": {
          "items": {
            "$ref": "#/$defs/AnimationCue"
          },
          "title": "Cues",
          "type": "array"
        },
        "generation_mode": {
          "enum": [
            "agent",
            "fallback",
            "mock"
          ],
          "title": "Generation Mode",
          "type": "string"
        },
        "repair_attempts": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Repair Attempts",
          "type": "integer"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "project_id",
        "scene_id",
        "revision",
        "context_hash",
        "timeline_hash",
        "source",
        "summary",
        "generation_mode"
      ],
      "title": "SceneBuild",
      "type": "object"
    },
    "SceneSlot": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "index": {
          "maximum": 6,
          "minimum": 1,
          "title": "Index",
          "type": "integer"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "end_frame": {
          "exclusiveMinimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "dialogue_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Dialogue Ids",
          "type": "array"
        },
        "entry_state": {
          "const": "clear_content",
          "default": "clear_content",
          "title": "Entry State",
          "type": "string"
        },
        "exit_state": {
          "const": "clear_content",
          "default": "clear_content",
          "title": "Exit State",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "index",
        "start_frame",
        "end_frame",
        "dialogue_ids"
      ],
      "title": "SceneSlot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "scene_id": {
      "title": "Scene Id",
      "type": "string"
    },
    "index": {
      "title": "Index",
      "type": "integer"
    },
    "slot": {
      "anyOf": [
        {
          "$ref": "#/$defs/SceneSlot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "generating",
        "rendering",
        "ready",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "current_revision": {
      "default": 0,
      "title": "Current Revision",
      "type": "integer"
    },
    "requested_revision": {
      "default": 1,
      "title": "Requested Revision",
      "type": "integer"
    },
    "active_job_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Job Id"
    },
    "progress": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Progress",
      "type": "number"
    },
    "build": {
      "anyOf": [
        {
          "$ref": "#/$defs/SceneBuild"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "preview": {
      "anyOf": [
        {
          "$ref": "#/$defs/RenderResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/PipelineError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "scene_id",
    "index"
  ],
  "title": "SceneState",
  "type": "object"
}
