{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "media_type",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "WordTiming": {
      "additionalProperties": false,
      "properties": {
        "word_id": {
          "title": "Word Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        }
      },
      "required": [
        "word_id",
        "text",
        "start_ms",
        "end_ms"
      ],
      "title": "WordTiming",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dialogue_id": {
      "title": "Dialogue Id",
      "type": "string"
    },
    "speaker_id": {
      "enum": [
        "sundar",
        "jensen"
      ],
      "title": "Speaker Id",
      "type": "string"
    },
    "wav": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "transcript": {
      "title": "Transcript",
      "type": "string"
    },
    "transcript_file": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "words_file": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "srt_file": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "duration_ms": {
      "exclusiveMinimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "frame_count": {
      "exclusiveMinimum": 0,
      "title": "Frame Count",
      "type": "integer"
    },
    "sample_rate_hz": {
      "const": 48000,
      "default": 48000,
      "title": "Sample Rate Hz",
      "type": "integer"
    },
    "channels": {
      "const": 1,
      "default": 1,
      "title": "Channels",
      "type": "integer"
    },
    "sample_count": {
      "exclusiveMinimum": 0,
      "title": "Sample Count",
      "type": "integer"
    },
    "words": {
      "items": {
        "$ref": "#/$defs/WordTiming"
      },
      "minItems": 1,
      "title": "Words",
      "type": "array"
    },
    "timing_quality": {
      "enum": [
        "provider",
        "forced_alignment",
        "mock"
      ],
      "title": "Timing Quality",
      "type": "string"
    }
  },
  "required": [
    "dialogue_id",
    "speaker_id",
    "wav",
    "transcript",
    "transcript_file",
    "words_file",
    "srt_file",
    "duration_ms",
    "frame_count",
    "sample_count",
    "words",
    "timing_quality"
  ],
  "title": "UtteranceAudio",
  "type": "object"
}
