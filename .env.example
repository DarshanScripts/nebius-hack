# Copy to .env. All credentials are server-side. Mock mode needs no provider keys.
MOCK_MODE=true
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
# Vite is configured with envDir: ".."; only VITE_* values reach the browser.
VITE_API_BASE_URL=http://localhost:8000
ARTIFACT_ROOT=./output
ASSETS_ROOT=./assets

# Tavily Research and Search use this same key.
TAVILY_API_KEY=
TAVILY_RESEARCH_MODEL=pro
TAVILY_POLL_INTERVAL_SECONDS=3
TAVILY_RESEARCH_TIMEOUT_SECONDS=600

# Selected NVIDIA-hosted Nemotron endpoint; GPU speech/rendering runs on Nebius.
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# tool_calling or json_prompt; select after the member 1 capability check.
NEMOTRON_STRUCTURED_MODE=json_prompt
NEMOTRON_TIMEOUT_SECONDS=180
SCENE_AGENT_CONCURRENCY=3
SCENE_REPAIR_ATTEMPTS=2

# Self-hosted Chatterbox Turbo on a Nebius GPU. These are our FastAPI routes.
# Local URLs below assume SSH port forwarding; use private GPU VM URLs in cloud.
VOICE_API_URL=http://localhost:8002/v1/tts
# Generate this bearer token yourself; it is NOT a Nebius or Resemble API key.
VOICE_API_KEY=
VOICE_MODEL=chatterbox-turbo
VOICE_DEVICE=cuda
VOICE_TIMEOUT_SECONDS=180
# Existing reference samples: assets/voices/{sundar,jensen}/reference.wav
# No hosted voice ID is needed for reference-audio conditioning.

# Self-hosted WhisperX forced alignment on the same Nebius GPU VM.
# Word timestamps are REQUIRED for live reels, not an optional extra.
ALIGNMENT_API_URL=http://localhost:8003/v1/align
# Generate this bearer token yourself. It may match VOICE_API_KEY.
ALIGNMENT_API_KEY=
ALIGNMENT_MODEL=WAV2VEC2_ASR_BASE_960H
ALIGNMENT_DEVICE=cuda
ALIGNMENT_TIMEOUT_SECONDS=180
# Known script -> forced alignment by default; ASR is optional for quality checks.
WHISPERX_TRANSCRIBE=false
WHISPERX_ASR_MODEL=small.en
WHISPERX_COMPUTE_TYPE=float16
# Serialize voice+alignment pipelines across projects on our single GPU.
SPEECH_GPU_PIPELINE_CONCURRENCY=1

# Public checkpoint downloads require no separate account/token in this setup.
# GPU containers: persist the libraries' default model caches and this Torch cache.
TORCH_HOME=/models/torch

# Internal Node/Remotion worker. Compose overrides this URL with renderer:8001.
RENDER_WORKER_URL=http://localhost:8001
RENDER_WORKER_PORT=8001
# Set a shared random secret in live deployment; do not expose to frontend.
RENDER_WORKER_TOKEN=
RENDER_JOB_TIMEOUT_SECONDS=900
RENDER_CONCURRENCY=1

# Deployment metadata: VM already created; await Running status and IP assignment.
# Final review name below; earlier Terraform preview used a different name.
NEBIUS_VM_NAME=cyan-ape-instance-8
NEBIUS_REGION=uk-south2
NEBIUS_PROJECT_ID=project-e05mfttbln00ypf4h123rz
NEBIUS_SUBNET_ID=vpcsubnet-e05xggeet8sf02btby
NEBIUS_SECURITY_GROUP_ID=vpcsecuritygroup-e05s1hk66ypwqtswpn
NEBIUS_SERVICE_ACCOUNT_NAME=group08-sa
# Both hosts identify the SAME VM. Fill its SSH address once assigned.
NEBIUS_VM_HOST=
NEBIUS_GPU_VM_HOST=
NEBIUS_SSH_USER=orange_whisky
# Owner's local key: .ssh/nebius_reel_ed25519; never copy into images or Git.
NEBIUS_SSH_KEY_PATH=
